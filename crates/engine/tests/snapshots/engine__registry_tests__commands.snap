    ],
    "shortcut": "Cmd+T",
    "defaultShortcut": "Cmd+T",
    "kind": "edit",
    "agent": "allowed",
    "params": "{xMm, yMm, text, family?, style?, heightMm?(10), letterSpacingMm?(0), lineSpacing?(1), align?\"left\"|\"center\"|\"right\", layer?}",
    "enabled": false,
    "disabledReason": "no document open",
    "needsDocument": true,
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`tools.text` parameters.",
      "properties": {
        "align": {
          "default": null,
          "description": "\"left\" (default), \"center\" or \"right\".",
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "default": null,
          "description": "Font family; default: the first available of the usual system names, else the first indexed family.",
          "type": [
            "string",
            "null"
          ]
        },
        "heightMm": {
          "default": null,
          "description": "Cap height in mm (default 10).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "layer": {
          "anyOf": [
            {
              "description": "A LightBurn layer: colour 0..=29, or \"C05\", \"05\", \"T1\", \"T2\" (case-insensitive).",
              "oneOf": [
                {
                  "maximum": 29,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "pattern": "^([CcTt]?[0-9]{1,2})$",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layer. Default: C00."
        },
        "letterSpacingMm": {
          "default": null,
          "description": "Extra advance per character in mm (default 0).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "lineSpacing": {
          "default": null,
          "description": "Line-height multiplier (default 1.0).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "style": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The text; `\\n` splits lines.",
          "type": "string"
        },
        "xMm": {
          "description": "Baseline anchor point (the alignment point), world mm.",
          "format": "double",
          "type": "number"
        },
        "yMm": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "xMm",
        "yMm",
        "text"
      ],
