  {
    "id": "path.set",
    "label": "Set Path Data",
    "menu": [],
    "shortcut": null,
    "defaultShortcut": null,
    "kind": "edit",
    "agent": "allowed",
    "params": "{id, d, coalesce?} replaces the object-space path; one undo step",
    "enabled": false,
    "disabledReason": "no document open",
    "needsDocument": true,
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`path.set` parameters.",
      "properties": {
        "coalesce": {
          "default": null,
          "description": "Consecutive sets sharing a key merge into one history entry (arrow-key nudges).",
          "type": [
            "string",
            "null"
          ]
        },
        "d": {
          "description": "SVG path data in the shape's object space (\"M…Z…\"). Must start with MoveTo; every number finite.",
          "type": "string"
        },
        "id": {
          "description": "The shape id.",
