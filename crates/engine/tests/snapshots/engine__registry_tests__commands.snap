  {
    "id": "file.import",
    "label": "Import…",
    "menu": [
      "File"
    ],
    "shortcut": "Cmd+I",
    "defaultShortcut": "Cmd+I",
    "kind": "edit",
    "agent": "rootsOnly",
    "params": "{path, layer?, centerMm?:[x,y], scale?, svgUnits?:\"physical\"|\"px96\"|\"px72\"}",
    "enabled": false,
    "disabledReason": "no document open",
    "needsDocument": true,
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`file.import`.",
      "properties": {
        "centerMm": {
          "default": null,
          "description": "Centre the import here (design mm). Default: file coordinates (SVG/DXF), the origin (images).",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "layer": {
          "anyOf": [
            {
              "description": "A LightBurn layer: colour 0..=29, or \"C05\", \"05\", \"T1\", \"T2\" (case-insensitive).",
              "oneOf": [
                {
                  "maximum": 29,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "pattern": "^([CcTt]?[0-9]{1,2})$",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Put every imported object on this layer. Default: colour → palette match, else the current layer."
        },
        "path": {
          "description": "File path (SVG, DXF, PNG/JPEG/BMP/TIFF/WebP/GIF, or an OpenMopa `workspace.json`).",
          "type": "string"
        },
        "scale": {
          "default": null,
          "description": "Scale factor (> 0). Default 1.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "svgUnits": {
          "default": null,
          "description": "SVG units. Default \"physical\": an SVG without physical units is refused.",
          "enum": [
            "physical",
            "px96",
            "px72",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "title": "ImportParams",
      "type": "object"
    }
  },
